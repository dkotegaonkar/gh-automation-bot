{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && prisma generate && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api,worker \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --env-file-if-exists=.env dist/main.js\" \"node --watch --env-file-if-exists=.env dist/main.worker.js\"",
    "start": "node dist/main.js",
    "start:worker": "node dist/main.worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1141.0",
    "@nestjs/common": "^12",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12",
    "@nestjs/platform-express": "^12",
    "@nestjs/schedule": "^12.0.2",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.4",
    "groq-sdk": "^1.6.0",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.2.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12",
    "@swc/core": "^1.16.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "pino-pretty": "^13.1.3",
    "typescript": "~5.9",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  }
}

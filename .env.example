# ─── apps/api (copy to apps/api/.env for local dev) ───────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Public URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# Neon Postgres — pooled URL for the app, direct URL for migrations
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require

# GitHub App (Settings → Developer settings → GitHub Apps)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# base64 of the downloaded .pem:  base64 -i your-app.private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -base64 32
ENCRYPTION_KEY_B64=

# AWS SQS (on EC2, credentials come from the instance IAM role; locally use `aws configure` / AWS_PROFILE)
AWS_REGION=us-east-1
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/gh-automation-queue
SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/gh-automation-dlq

# Groq (optional — AI triage is skipped when unset)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── apps/web (Vercel env / apps/web/.env.local) ─────────────────────────────
# API_URL=http://localhost:4000
